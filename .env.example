# ==============================================================================
# Smart Clinic — Environment Configuration (.env.example)
# Aligned with Philippine Health Data Security Standards (RA 10173)
# ==============================================================================

# Server Network & Runtime
PORT=3000
NODE_ENV=development

# JWT Security & Tenant Isolation (RA 10173)
JWT_SECRET=smart_clinic_production_jwt_secret_key_2026_ph_health_data
ADMIN_PASSWORD=SmartClinic@Admin2026

# Google Gemini Clinical AI Assistant API
GEMINI_API_KEY=

# ==============================================================================
# 1. REAL LIVE SMTP EMAIL CONFIGURATION (Nodemailer)
# ==============================================================================
# Supports any standard SMTP provider:
# - Google Gmail: smtp.gmail.com (Port 465 SSL or 587 TLS) + Google App Password
# - Microsoft Outlook / Office 365: smtp.office365.com (Port 587 TLS)
# - SendGrid: smtp.sendgrid.net (Port 587) + API Key as password
# - Amazon SES: email-smtp.<region>.amazonaws.com (Port 465 or 587)
# - Mailgun / Postmark / Brevo: standard SMTP credentials
#
# FOR GMAIL SETUP:
# 1. Enable 2-Step Verification in Google Account Settings: https://myaccount.google.com/security
# 2. Go to 'App Passwords': https://myaccount.google.com/apppasswords
# 3. Create app named 'Smart Clinic' and copy the 16-character password (e.g. abcd efgh ijkl mnop)
# 4. Paste without spaces into SMTP_PASSWORD

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=smartclinicrealacc@gmail.com
SMTP_PASSWORD=
SMTP_FROM_EMAIL=smartclinicrealacc@gmail.com
SMTP_FROM_NAME="Smart Clinic Healthcare"
SMTP_SECURE=true

# Legacy aliases supported automatically:
# SMTP_EMAIL=smartclinicrealacc@gmail.com
# SMTP_APP_PASSWORD=
# SMTP_PASS=
# SMTP_FROM=smartclinicrealacc@gmail.com

# ==============================================================================
# 2. REAL LIVE SMS CONFIGURATION (Twilio Cellular Carrier Gateway)
# ==============================================================================
# Supports cellular delivery to Philippine carriers (Globe, Smart, DITO) and worldwide.
#
# HOW TO GET TWILIO CREDENTIALS:
# 1. Sign up at https://www.twilio.com/
# 2. In Twilio Console Dashboard:
#    - Copy 'Account SID' (starts with AC...) -> TWILIO_ACCOUNT_SID
#    - Copy 'Auth Token' -> TWILIO_AUTH_TOKEN
# 3. Buy or configure an SMS-enabled Phone Number (e.g. +1... or Philippine Alphanumeric/Local)
#    - Copy phone number -> TWILIO_PHONE_NUMBER (in E.164 format: +1234567890 or +63917...)

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_FROM_NUMBER=

# ==============================================================================
# 3. CLOUD DATABASE PERSISTENCE (Supabase PostgreSQL)
# ==============================================================================
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
