# ─── Smart Clinic production environment ───────────────────────────
# Copy to .env / Vercel project settings. Never commit real secrets.

NODE_ENV=production
PORT=3000

GEMINI_API_KEY=

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=

# ─── Email OTP / Admin 2FA (Gmail SMTP + App Password) ─────────────
# Account: smartclinicrealacc@gmail.com
# 1. Enable 2-Step Verification
# 2. Create App Password: https://myaccount.google.com/apppasswords
# 3. Paste the 16-character app password (not account password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=smartclinicrealacc@gmail.com
SMTP_EMAIL=smartclinicrealacc@gmail.com
SMTP_FROM=smartclinicrealacc@gmail.com
SMTP_APP_PASSWORD=xxxx xxxx xxxx xxxx

# ─── SMS OTP (Twilio) ──────────────────────────────────────────────
# https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_FROM_NUMBER=+1234567890
