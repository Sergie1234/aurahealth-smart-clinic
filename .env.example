# ==============================================================================
# Smart Clinic — Environment Configuration (.env.example)
# Aligned with Philippine Health Data Security Standards (RA 10173)
# ==============================================================================

# Server Network & Runtime
PORT=3000
NODE_ENV=development

# JWT Security & Tenant Isolation (RA 10173)
JWT_SECRET=smart_clinic_production_jwt_secret_key_2026_ph_health_data
ADMIN_PASSWORD=SmartClinic@Admin2026

# Google Gemini Clinical AI Assistant API
GEMINI_API_KEY=

# Real SMTP Email Service (Nodemailer 2FA & Patient Verification)
# Configured for smartclinicrealacc@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=smartclinicrealacc@gmail.com
SMTP_EMAIL=smartclinicrealacc@gmail.com
SMTP_APP_PASSWORD=
SMTP_FROM=smartclinicrealacc@gmail.com

# Real SMS OTP Service (Twilio Phone Authentication)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Cloud Database Persistence (Supabase PostgreSQL)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
