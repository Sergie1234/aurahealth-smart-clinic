# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI or Vercel Environment Variables.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# In Vercel or Cloud Run, set this to your deployment domain (e.g., https://aurahealth.vercel.app).
APP_URL="MY_APP_URL"

# ==========================================
# SUPABASE DATABASE & BACKEND INTEGRATION
# ==========================================
# Client-side (Vite) Supabase configuration:
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# Server-side (Vercel Serverless / Express) Supabase configuration:
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="your-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-for-admin-operations"

# ==========================================
# VERCEL HOSTING SETTINGS
# ==========================================
# Automatically set by Vercel in preview and production environments:
# VERCEL_URL="your-deployment.vercel.app"

