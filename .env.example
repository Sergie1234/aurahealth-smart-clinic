# ==============================================================================
# Smart Clinic — Environment Variables Specification & Vercel Deployment Guide
# Aligned with Philippine Health Data Security Standards (RA 10173).
# ==============================================================================

# 1. API & Backend Routing
# For unified Vercel deployments (frontend + /api serverless functions), leave VITE_API_URL empty.
# Only define VITE_API_URL if your backend is hosted on a separate custom domain (e.g., https://api.smartclinic.ph).
VITE_API_URL=

# 2. Security & Authentication Secrets
ADMIN_EMAIL=smartclinicrealacc@gmail.com
ADMIN_PASSWORD=SmartClinic@Admin2026
ADMIN_TOTP_SECRET=
JWT_SECRET=smart_clinic_super_secure_jwt_secret_2026_ph_health_data

# 3. Google Gemini AI Engine
# Required for server-side AI SOAP notes, ICD-10 diagnostics, and clinical summaries
GEMINI_API_KEY=

# 4. Supabase Database (Optional Cloud Sync)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# 5. Email Notifications & Password Resets (SMTP / Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Smart Clinic Health

# 6. SMS Dispatch Gateway (Twilio Integration)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_FROM_NUMBER=